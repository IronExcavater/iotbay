{
    "name": "iotbay",
    "description": "IoTBay monorepo containing both the React frontend and Flask backend",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "web",
        "api"
    ],
    "scripts": {
        "prepare": "husky",
        "postinstall": "npm run sync --workspaces --if-present",
        "sync": "npm install",
        "dev": "concurrently -n web,api -c cyan,magenta \"npm run -w web dev\" \"npm run -w api dev\"",
        "build": "npm run build --workspaces --if-present",
        "test": "npm run test --workspaces --if-present",
        "test:unit": "npm run -w api test:unit",
        "test:api": "npm run -w api test:api",
        "test:e2e": "npm run -w api test:e2e",
        "check:all": "npm run check:all --workspaces",
        "fix:staged": "lint-staged --config lint-staged.config.js",
        "fix:all": "npm run fix:all --workspaces --if-present"
    },
    "devDependencies": {
        "concurrently": "^9.2.1",
        "husky": "^9.0.11",
        "lint-staged": "^16.2.6"
    }
}
