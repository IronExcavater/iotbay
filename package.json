{
    "name": "iotbay",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "web",
        "api"
    ],
    "scripts": {
        "prepare": "husky",
        "postinstall": "npm run -w api sync",
        "dev": "concurrently \"npm run -w web dev\" \"npm run -w api dev\"",
        "fix:staged": "lint-staged --config lint-staged.config.js",
        "fix:all": "npm run -w web fix:all && npm run -w api fix:all"
    },
    "devDependencies": {
        "husky": "^9.0.11",
        "lint-staged": "^16.2.6"
    }
}
