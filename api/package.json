{
    "name": "iotbay-api",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "venv:create": "python3 -m venv .venv",
        "deps:install": ".venv/bin/python -m pip install -r requirements.txt",
        "dev": ".venv/bin/python -m flask --app run:app --debug run --host 0.0.0.0 --port 5000",
        "lint": ".venv/bin/python -m ruff check .",
        "lint:fix": ".venv/bin/python -m ruff check . --fix && .venv/bin/python -m ruff format .",
        "test": ".venv/bin/python -m unittest discover -s tests -p 'test_*.py' -v"
    }
}
