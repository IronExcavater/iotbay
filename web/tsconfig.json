{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "types": ["vite/client"],
        "paths": {
            "@app/*": ["./src/app/*"],
            "@features/*": ["./src/features/*"],
            "@shared/*": ["./src/shared/*"]
        }
    },
    "include": ["src", "vite.config.ts"]
}
