{
    "name": "iotbay-web",
    "description": "React frontend for IoTBay",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "typecheck": "tsc --noEmit",
        "eslint": "eslint .",
        "eslint:fix": "eslint . --fix",
        "stylelint": "stylelint \"src/**/*.{css,scss}\" --allow-empty-input",
        "stylelint:fix": "stylelint \"src/**/*.{css,scss}\" --allow-empty-input --fix",
        "prettier": "prettier . -c",
        "prettier:fix": "prettier . -wu --log-level warn",
        "check:all": "npm run typecheck && npm run eslint && npm run stylelint && npm run prettier",
        "fix:all": "npm run typecheck && npm run eslint:fix && npm run stylelint:fix && npm run prettier:fix"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "libphonenumber-js": "^1.12.41",
        "luxon": "^3.7.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-icons": "^5.6.0",
        "react-router-dom": "^7.9.6"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@tailwindcss/vite": "^4.2.1",
        "@types/luxon": "^3.7.1",
        "@types/react": "^19.0.8",
        "@types/react-dom": "^19.0.3",
        "@vitejs/plugin-react": "^5.1.4",
        "eslint": "^9.39.0",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-tailwind-canonical-classes": "^1.1.0",
        "eslint-plugin-tailwindcss": "^4.0.0-beta.0",
        "eslint-plugin-unused-imports": "^4.3.0",
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.7.1",
        "postcss-scss": "^4.0.9",
        "sass": "^1.93.2",
        "stylelint": "^16.26.0",
        "stylelint-config-standard-scss": "^16.0.0",
        "stylelint-config-tailwindcss": "^1.0.0",
        "stylelint-prettier": "^5.0.3",
        "tailwindcss": "^4.2.1",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.53.1",
        "vite": "^7.3.1"
    }
}
